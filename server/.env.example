PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ==========================================
# MongoDB Database Connection
# ==========================================
# Examples:
# - MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/resolveflow?retryWrites=true&w=majority
# - Local MongoDB: mongodb://127.0.0.1:27017/resolveflow
# - Zero-config fallback: Leave blank to use automated in-memory MongoDB
MONGODB_URI=

# ==========================================
# Authentication & Security Keys
# ==========================================
JWT_SECRET=resolveflow_ai_dev_jwt_secret_key_2026_super_secure!
JWT_EXPIRES_IN=7d
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ==========================================
# AI LLM Providers (Optional - Deterministic RAG active if empty)
# ==========================================
# Groq Cloud API (Recommended for ultra-fast Llama-3.3-70b / Llama-3.1 inference)
# Free keys available at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenRouter API (Claude 3.5, GPT-4o, etc.)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ==========================================
# Optional Third-Party Integrations
# ==========================================
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5000/api/integrations/gmail/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_WEBHOOK_URL=

# ==========================================
# Resend HTTP Email API (Live Email Delivery)
# ==========================================
# Get a key at: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM=ResolveFlow AI <onboarding@resend.dev>
